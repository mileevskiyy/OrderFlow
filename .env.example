# Export values in your terminal; Spring Boot does not automatically load this file.
# Docker Compose reads .env for substitution.
POSTGRES_PASSWORD=choose_a_long_url_safe_password
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=choose_a_unique_password_at_least_16_characters
# Optional when running Java directly with a PostgreSQL server:
# JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/orderflow
# DB_USER=orderflow
# DB_PASSWORD=your_database_password
# PRODUCTION=true
# COOKIE_SECURE=true
# HOST=0.0.0.0

# 0 = 15 minutes normally / 60 seconds in public demo; explicit range 1..86400 seconds.
# RESERVATION_TTL_SECONDS=0
# RESERVATION_POLL_MS=5000
# RESERVATION_EXPIRY_WORKER=true
